# 目标芯片：ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# 板子为 16MB Flash / 8MB PSRAM / 240MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# esp-sr 的唤醒词模型需要大量内存，必须开 PSRAM（八线 8MB）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 自定义分区表：带一个 model 分区给 esp-sr 放模型
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 唤醒词模型：小鹿小鹿（换成别的模型时，这里和下面的 AMYAI_WAKE_MODEL 一起改）
CONFIG_SR_WN_WN9_XIAOLUXIAOLU_TTS2=y
CONFIG_AMYAI_WAKE_MODEL="wn9_xiaoluxiaolu_tts2"
CONFIG_AMYAI_WAKE_TEXT="小鹿小鹿"

# BLE 配网需要蓝牙协议栈：用 NimBLE（比 Bluedroid 省 RAM，配网完还会整块释放）
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# ESP-IDF 6.x 默认关闭 protocomm 安全版本 1，配网用 PoP 必须显式打开
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_AMYAI_PROV_ENABLE=y
CONFIG_AMYAI_PROV_POP="abcd1234"
CONFIG_AMYAI_PROV_NAME_PREFIX="AMYAI"
CONFIG_AMYAI_PROV_TIMEOUT_SEC=300
CONFIG_AMYAI_PROV_RESET_GPIO=0
CONFIG_AMYAI_PROV_RESET_HOLD_MS=3000

# 音频引脚：默认未配置（-1），确定后在这里填，或用 menuconfig 改
CONFIG_AMYAI_I2C_SDA=48
CONFIG_AMYAI_I2C_SCL=45
CONFIG_AMYAI_I2S_MCLK=-1
CONFIG_AMYAI_I2S_BCLK=21
CONFIG_AMYAI_I2S_WS=13
CONFIG_AMYAI_I2S_DIN=47
CONFIG_AMYAI_I2S_DOUT=14
CONFIG_AMYAI_PA_PIN=-1

# 下面三项含敏感信息，故意留空。
# 实际值只写在 sdkconfig 里（已在 .gitignore 中），不要提交到仓库。
CONFIG_AMYAI_WIFI_SSID=""
CONFIG_AMYAI_WIFI_PASSWORD=""
CONFIG_AMYAI_LLM_API_KEY=""
# 离线命令词识别（MultiNet7 中文）：唤醒后先本地识别，未命中再走云端
# 模型包约 2.8MB，需要 model 分区 >= 4MB（见 partitions.csv）
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_MN_LOAD_MODE_PSRAM_FLASH=y

# TTS / ASR 的 Key 同样不入库
